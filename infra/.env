UID=1000
GID=1000
SHARED_MEMORY=8g

NVIDIA_VISIBLE_DEVICES=all
WANDB_API_KEY=~/.wandb_api_key
WANDB_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true
OTEL_LOGS_EXPORTER=none
OTEL_METRICS_EXPORTER=none
WANDB_SILENT=true
WANDB_CORE=false
SYNOLOGY_CHAT_WEBHOOK_URL=~/.synology_chat_webhook_url

JUPYTER_TOKEN=~/.jupyter_token
NOTEBOOKS_DIR=../notebooks

SRC_DIR=../src
DATA_DIR=/mnt/nas/baecm/starcraft-vision/data
MODELS_DIR=/mnt/nas/baecm/starcraft-vision/models
TORCH_CACHE_DIR=/mnt/nas/baecm/starcraft-vision/.torch_cache
PREDICTIONS_DIR=/mnt/nas/baecm/starcraft-vision/predictions
RESULTS_DIR=/mnt/nas/baecm/starcraft-vision/results

CONF_DIR=../conf