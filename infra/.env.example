# UID/GID: 컨테이너가 이 값으로 실행된다. 아래 *_DIR 로 마운트되는 디렉터리의
# 소유자와 반드시 일치시킬 것. 다르면 PermissionError 로 실패한다.
#   - 로컬 디스크 경로면 보통 `id -u` / `id -g`
#   - CIFS/NFS 마운트면 그 마운트의 uid=/gid= 옵션 값 (ls -ldn 으로 확인)
UID=1000
GID=1000
SHARED_MEMORY=8g

NVIDIA_VISIBLE_DEVICES=all
WANDB_API_KEY=~/.wandb_api_key
WANDB_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true
OTEL_LOGS_EXPORTER=none
OTEL_METRICS_EXPORTER=none
WANDB_SILENT=true
WANDB_CORE=false
SYNOLOGY_CHAT_WEBHOOK_URL=~/.synology_chat_webhook_url

JUPYTER_TOKEN=~/.jupyter_token
NOTEBOOKS_DIR=../notebooks

SRC_DIR=../src
DATA_DIR=/path/to/starcraft-vision/data
MODELS_DIR=/path/to/starcraft-vision/models
TORCH_CACHE_DIR=/path/to/starcraft-vision/.torch_cache
PREDICTIONS_DIR=/path/to/starcraft-vision/predictions
RESULTS_DIR=/path/to/starcraft-vision/results

CONF_DIR=../conf
